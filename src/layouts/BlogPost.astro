---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import AuthorBio from '../components/AuthorBio.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
// import Image from 'astro/components/Image.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	author?: CollectionEntry<'authors'>;
};

const { title, description, resources, pubDate, updatedDate, heroImage, leftImages, rightImage, author, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			a {
				text-decoration: none;
				color: black;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				/* margin: 0 0 0.5em 0; */
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.author-bio {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<slot name="reading-time" />
						<hr />
					</div>

					<div class="row">
						<div class="left-column">
							{
								leftImages && leftImages.length > 0 && (
									leftImages.map((img) => (
										<Image width={200} height={350} src={img.image} alt={img.alt} />
									))
								)
							}
						</div>

						<div class="main-column">
							<slot />
						</div>
						
						<div class="right-column">
							<br/>
							{
								rightImage && <Image width={296} height={281} src={rightImage.image} alt={rightImage.alt} />
							}
							<br/>
						</div>
					</div>

					{
						resources && resources.length > 0 && (
							<div class="tags">
								Resources:
								{
										resources.map((link) => (
											<a href={link.url} target="_blank" rel="noopener noreferrer" class="tag resource">
													{link.text}
											</a>
										))
								}
							</div>
						)
					}
					
					{
						tags && tags.length > 0 && (
							<div class="tags">
								Tagged:
										{tags.map((tag) => (
											<a href={`/tags/${tag}`} class="tag">{tag}</a>
										))}
									
								
							</div>
						)
					}

					<div class="author-bio">
						{author && <AuthorBio author={author} />}
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
