---
import { getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

const { slug } = Astro.params;
const post = slug ? await getEntry('blog', slug) : undefined;
if (!post) {
	return new Response(null, {status: 404});
}

const { Content, remarkPluginFrontmatter } = await render(post);
const author = post.data.author ? await getEntry(post.data.author) : undefined;
---

<BlogPost {...post.data} author={author}>
	<style>
		.reading-time {
			margin: .2em;
			padding-inline: .75em;
			padding-block: .4em;
			justify-content: center;
			align-items: center;
			display: inline-flex;
			border-radius: 5px;
			border: 1px solid;
		}
	</style>

	<p class="reading-time" slot="reading-time">{remarkPluginFrontmatter.minutesRead}</p>

	<Content />
</BlogPost>