---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Gold Gaisce Portfolio</h1>
			<p>
				I've been working on my Gold Gaisce since October 2025. I previously achieved my Bronze & Silver awards.
			</p>
			<p>
				<b>Community Involvement:</b> Kids' Church sign-in desk </br>
				<b>Physical Activity:</b> Walking </br>
				<b>Personal Skill:</b> Arts & Craft
			</p>
			<p>
				<b>Residential:</b> Undecided </br>
				<b>Adventure Journey:</b> 80km hike </br>
		</main>
		<Footer />
	</body>
</html>
